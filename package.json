{
  "name": "ai-jira-ticket",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI agent that turns colloquial descriptions into spec-compliant Jira tickets (spec lives in Confluence)",
  "scripts": {
    "ajt": "tsx src/cli/index.ts",
    "web": "tsx src/server/index.ts",
    "dev:web": "vite web",
    "build:web": "vite build web",
    "fetch-issues": "tsx scripts/fetch-issues.ts",
    "fetch-users": "tsx scripts/fetch-users.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@aws-sdk/client-s3": "^3.1083.0",
    "commander": "^14.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "marklassian": "^1.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsx": "^4.22.4",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.0.3",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.8"
  }
}
