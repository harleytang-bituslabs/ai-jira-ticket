# Atlassian Cloud — Jira and Confluence share the same site + credentials (Basic auth).
# Generate a token at https://id.atlassian.com/manage-profile/security/api-tokens
# (CONFLUENCE_BASE_URL / CONFLUENCE_EMAIL / CONFLUENCE_API_TOKEN are accepted as fallbacks,
#  so an .env from the ai-game-whole-game-pipeline project works unchanged.)
ATLASSIAN_BASE_URL=https://your-site.atlassian.net
ATLASSIAN_EMAIL=you@example.com
ATLASSIAN_API_TOKEN=

# Anthropic
ANTHROPIC_API_KEY=

# Optional: override the model used for drafting (default: DEFAULT_MODEL in src/core/config.ts)
# AJT_MODEL=

# ── Web service only (the CLI ignores everything below) ──

# HMAC key for session tokens, ≥32 random chars (openssl rand -hex 32). Must stay
# stable across restarts; unset means a random key per process and everyone is logged out.
# SESSION_SECRET=

# Seeds the first admin when the user table is empty; no effect afterwards.
# AJT_ADMIN_EMAIL=
# AJT_ADMIN_PASSWORD=
# AJT_ADMIN_NAME=

# Set to store drafts, users and the shared reference cache in S3; unset = local files.
# AJT_S3_BUCKET=
# AWS_REGION=us-west-2

# Bind address (default 127.0.0.1:9300). The systemd unit sets these itself.
# AJT_HOST=127.0.0.1
# AJT_PORT=9300
